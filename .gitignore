# Local-only by default: publish source and the portable animation package.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/build-*.mjs
!/render-*.cjs
!/deliverables/
/deliverables/*
!/deliverables/brass-mechanical-animation/
!/output/
/output/*
!/output/contract-brass-sample.html
!/output/risk-system.html
!/output/risk-mechanical-film.html
!/output/film-v2/
!/output/film-classic/
!/output/film-eighteenth/
!/output/mechanical-jellyfish/
!/output/mechanical-whale-30/
!/output/mechanical-whale-finesse/
!/output/mechanical-whale-rebuild/
!/output/audit-alert-30/
!/output/audit-caseflow-30/
!/output/audit-caseflow-60/
!/output/audit-convergence-60/
!/output/audit-laboratory-film/
!/output/audit-observatory-30/

# Keep scene code, configuration, dependency sources, and attribution.
/output/*/*
!/output/*/*.js
!/output/*/*.mjs
!/output/*/*.cjs
!/output/*/*.py
!/output/*/*.html
!/output/*/content.json
!/output/*/package.json
!/output/*/requirements.txt
!/output/*/ASSETS.md
!/output/*/vendor/

# Never publish credentials, installed dependencies, or render caches.
**/node_modules/
**/__pycache__/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*credentials*
**/*.log
**/.DS_Store
**/Thumbs.db
